{% assign current_team = team_name | default: merge_variables.team_name %}
{% assign current_conf = conference | default: merge_variables.conference %}
{% assign current_standing = standing | default: merge_variables.standing %}
{% assign current_points = points | default: merge_variables.points %}
{% assign current_wins = wins | default: merge_variables.wins %}
{% assign current_draws = draws | default: merge_variables.draws %}
{% assign current_losses = losses | default: merge_variables.losses %}
{% assign current_last_result = last_result | default: merge_variables.last_result %}
{% assign current_next_game = next_game | default: merge_variables.next_game %}
{% assign current_next_game_2 = next_game_2 | default: merge_variables.next_game_2 %}
{% assign current_next_game_3 = next_game_3 | default: merge_variables.next_game_3 %}
{% assign current_updated_at = updated_at | default: merge_variables.updated_at %}
{% assign is_no_upcoming = no_upcoming | default: merge_variables.no_upcoming %}

<div class="layout layout--col gap--space-between lg:gap--large portrait:gap--small">

  <!-- Header: Team name + standing -->
  <div class="flex gap--medium align-items--center">
    <div class="flex flex--col">
      <span class="title title--large">{{ current_team }}</span>
      <span class="label label--small label--underline">
        ⚽ {{ current_conf }} Conf &nbsp;•&nbsp; #{{ current_standing }} &nbsp;•&nbsp; {{ current_points }} pts
      </span>
    </div>
  </div>

  <!-- Record bar -->
  <div class="flex gap--large lg:gap--xlarge">
    <div class="item">
      <span class="value value--medium">{{ current_wins }}</span>
      <span class="label">W</span>
    </div>
    <div class="item">
      <span class="value value--medium">{{ current_draws }}</span>
      <span class="label">D</span>
    </div>
    <div class="item">
      <span class="value value--medium">{{ current_losses }}</span>
      <span class="label">L</span>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Last Result -->
  {% if current_last_result %}
  <div class="flex flex--col gap--small">
    <span class="label label--underline">LAST RESULT</span>
    <div class="flex gap--medium align-items--center portrait:flex--wrap">
      <span class="badge badge--{% if current_last_result.outcome == 'W' %}success{% elsif current_last_result.outcome == 'L' %}danger{% else %}neutral{% endif %} value--medium">
        {{ current_last_result.outcome }}
      </span>
      <span class="value">
        {% if current_last_result.is_home %}vs {% else %}@ {% endif %}{{ current_last_result.opponent }}
      </span>
      <span class="value value--medium ml--auto">{{ current_last_result.score }}</span>
      <span class="label ml--small">{{ current_last_result.date }}</span>
    </div>
  </div>
  <div class="divider"></div>
  {% endif %}

  <!-- Upcoming Fixtures (Next 3 Games) -->
  <div class="flex flex--col gap--small">
    <span class="label label--underline">UPCOMING MATCHES</span>

    {% if is_no_upcoming or current_next_game == nil %}
      <span class="label">Season complete — no upcoming fixtures.</span>
    {% else %}

      {% if current_next_game %}
      <div class="flex gap--medium align-items--center">
        <span class="label label--small">▶</span>
        <span class="value">
          {% if current_next_game.is_home %}vs {% else %}@ {% endif %}{{ current_next_game.opponent }}
        </span>
        <span class="label ml--auto">{{ current_next_game.date }} &nbsp; {{ current_next_game.time }}</span>
      </div>
      {% endif %}

      {% if current_next_game_2 %}
      <div class="flex gap--medium align-items--center">
        <span class="label label--small">▶</span>
        <span class="value">
          {% if current_next_game_2.is_home %}vs {% else %}@ {% endif %}{{ current_next_game_2.opponent }}
        </span>
        <span class="label ml--auto">{{ current_next_game_2.date }} &nbsp; {{ current_next_game_2.time }}</span>
      </div>
      {% endif %}

      {% if current_next_game_3 %}
      <div class="flex gap--medium align-items--center">
        <span class="label label--small">▶</span>
        <span class="value">
          {% if current_next_game_3.is_home %}vs {% else %}@ {% endif %}{{ current_next_game_3.opponent }}
        </span>
        <span class="label ml--auto">{{ current_next_game_3.date }} &nbsp; {{ current_next_game_3.time }}</span>
      </div>
      {% endif %}

    {% endif %}
  </div>

  <!-- Footer: last updated -->
  <div class="title--small label label--faded">Updated {{ current_updated_at }}</div>

</div>

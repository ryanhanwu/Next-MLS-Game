<div class="layout layout--col gap--space-between">
  <div class="flex flex--between flex--center-y">
    <div class="flex flex--col">
      <span class="title title--medium">{{ team_name | default: "MLS Team" }}</span>
      <span class="label label--small">⚽ {{ conference | default: "MLS" }} #{{ standing | default: "-" }} • {{ points | default: "0" }} pts</span>
    </div>
    <div class="flex gap--medium">
      <span class="value">{{ wins | default: "0" }}W</span>
      <span class="value">{{ draws | default: "0" }}D</span>
      <span class="value">{{ losses | default: "0" }}L</span>
    </div>
  </div>

  <div class="divider"></div>

  <div class="flex flex--between">
    {% if last_result %}
    <div class="flex flex--col gap--tiny">
      <span class="label label--underline">LAST RESULT</span>
      <span class="value">
        [{{ last_result.outcome | default: "FT" }}] {% if last_result.is_home %}vs{% else %}@{% endif %} {{ last_result.opponent_abbr | default: "OPP" }} {{ last_result.score | default: "" }}
      </span>
    </div>
    {% endif %}

    {% if next_game %}
    <div class="flex flex--col gap--tiny">
      <span class="label label--underline">NEXT MATCH</span>
      <span class="value">
        {% if next_game.is_home %}vs{% else %}@{% endif %} {{ next_game.opponent_abbr | default: "OPP" }} • {{ next_game.date | default: "TBD" }}
      </span>
    </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ team_name | default: "MLS Tracker" }}</span>
  <span class="instance">MLS</span>
</div>

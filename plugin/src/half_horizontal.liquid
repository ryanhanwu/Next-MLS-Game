<div class="layout layout--col gap--space-between lg:gap--large portrait:gap--tiny">
  <div class="flex flex--between flex--center-y">
    <div class="flex flex--col">
      <span class="title title--medium lg:title--xlarge">{{ team_name | default: "MLS Team" }}</span>
      <span class="label label--small lg:label--base">{{ conference | default: "MLS" }} #{{ standing | default: "-" }} • {{ points | default: "0" }} pts</span>
    </div>
    <div class="flex gap--medium lg:gap--xlarge portrait:gap--small lg:w--full">
      <div class="item"><div class="meta"></div><div class="content"><span class="value lg:value--xlarge pr--3">{{ wins | default: "0" }}</span><span class="label lg:label--base">W</span></div></div>
      <div class="item"><div class="meta"></div><div class="content"><span class="value lg:value--xlarge pr--3">{{ draws | default: "0" }}</span><span class="label lg:label--base">D</span></div></div>
      <div class="item"><div class="meta"></div><div class="content"><span class="value lg:value--xlarge pr--3">{{ losses | default: "0" }}</span><span class="label lg:label--base">L</span></div></div>
      <div class="hidden lg:flex item"><div class="meta"></div><div class="content"><span class="value lg:value--xlarge pr--3">{{ points | default: "0" }}</span><span class="label lg:label--base">PTS</span></div></div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="flex gap--xlarge portrait:gap--medium">
    {% if last_result %}
    <div class="flex flex--col gap--tiny">
      <span class="label label--underline lg:label--base">LAST RESULT</span>
      <span class="value lg:value--large">
        [{{ last_result.outcome | default: "FT" }}] {% if last_result.is_home %}vs{% else %}@{% endif %} {{ last_result.opponent_abbr | default: last_result.opponent }} {{ last_result.score | default: "" }}
      </span>
    </div>
    {% endif %}

    {% if next_game %}
    <div class="flex flex--col gap--tiny">
      <span class="label label--underline lg:label--base">NEXT MATCH</span>
      <span class="value lg:value--large">
        {% if next_game.is_home %}vs{% else %}@{% endif %} {{ next_game.opponent_abbr | default: next_game.opponent }} • {{ next_game.date | default: "TBD" }}
      </span>
    </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ team_name | default: "MLS Tracker" }}</span>
  <span class="instance">MLS</span>
</div>
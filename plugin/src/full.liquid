<div class="layout layout--col gap--space-between lg:gap--large portrait:gap--small">

  <!-- Header: Team name + standing -->
  <div class="flex flex--col gap--tiny">
    <span class="title title--large">{{ team_name | default: "MLS Team" }}</span>
    <span class="label label--small label--underline">
      ⚽ {{ conference | default: "MLS" }} Conf &nbsp;•&nbsp; #{{ standing | default: "-" }} &nbsp;•&nbsp; {{ points | default: "0" }} pts
    </span>
  </div>

  <!-- Record bar -->
  <div class="flex gap--large lg:gap--xlarge">
    <div class="item">
      <span class="value value--medium">{{ wins | default: "0" }}</span>
      <span class="label">W</span>
    </div>
    <div class="item">
      <span class="value value--medium">{{ draws | default: "0" }}</span>
      <span class="label">D</span>
    </div>
    <div class="item">
      <span class="value value--medium">{{ losses | default: "0" }}</span>
      <span class="label">L</span>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Last Result -->
  {% if last_result %}
  <div class="flex flex--col gap--small">
    <span class="label label--underline">LAST RESULT</span>
    <div class="flex flex--between flex--center-y portrait:flex--wrap">
      <div class="flex flex--center-y gap--small">
        <span class="label label--filled {% if last_result.outcome == 'W' %}label--success{% elsif last_result.outcome == 'L' %}label--error{% else %}label--warning{% endif %}">
          {{ last_result.outcome | default: "FT" }}
        </span>
        <span class="value">
          {% if last_result.is_home %}vs {% else %}@ {% endif %}{{ last_result.opponent | default: "Opponent" }}
        </span>
      </div>
      <div class="flex flex--center-y gap--small">
        <span class="value value--medium">{{ last_result.score | default: "FT" }}</span>
        <span class="label label--gray">{{ last_result.date | default: "" }}</span>
      </div>
    </div>
  </div>
  <div class="divider"></div>
  {% endif %}

  <!-- Upcoming Fixtures (Next 3 Games) -->
  <div class="flex flex--col gap--small">
    <span class="label label--underline">UPCOMING MATCHES</span>

    {% if no_upcoming or next_game == nil %}
      <span class="label label--gray">Season complete — no upcoming fixtures.</span>
    {% else %}

      {% if next_game %}
      <div class="flex flex--between flex--center-y">
        <span class="value">
          ▶ {% if next_game.is_home %}vs {% else %}@ {% endif %}{{ next_game.opponent | default: "Opponent" }}
        </span>
        <span class="label label--gray">{{ next_game.date | default: "TBD" }} &nbsp; {{ next_game.time | default: "" }}</span>
      </div>
      {% endif %}

      {% if next_game_2 %}
      <div class="flex flex--between flex--center-y">
        <span class="value">
          ▶ {% if next_game_2.is_home %}vs {% else %}@ {% endif %}{{ next_game_2.opponent | default: "Opponent" }}
        </span>
        <span class="label label--gray">{{ next_game_2.date | default: "TBD" }} &nbsp; {{ next_game_2.time | default: "" }}</span>
      </div>
      {% endif %}

      {% if next_game_3 %}
      <div class="flex flex--between flex--center-y">
        <span class="value">
          ▶ {% if next_game_3.is_home %}vs {% else %}@ {% endif %}{{ next_game_3.opponent | default: "Opponent" }}
        </span>
        <span class="label label--gray">{{ next_game_3.date | default: "TBD" }} &nbsp; {{ next_game_3.time | default: "" }}</span>
      </div>
      {% endif %}

    {% endif %}
  </div>

  <!-- Footer: last updated -->
  <div class="label label--small label--gray">Updated {{ updated_at | default: "Recently" }}</div>

</div>

<div class="title_bar">
  <span class="title">{{ team_name | default: "MLS Tracker" }}</span>
  <span class="instance">MLS</span>
</div>
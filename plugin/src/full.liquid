<div class="layout layout--col gap--space-between lg:gap--xlarge portrait:gap--small">

  <!-- Header: Team name + standing -->
  <div class="flex flex--col gap--tiny">
    <div class="flex flex--between flex--center-y">
      <span class="title title--large lg:title--xxlarge">{{ team_name | default: "MLS Team" }}</span>
      <span class="hidden lg:inline label label--large label--gray">MLS</span>
    </div>
    <span class="label label--small lg:label--base label--underline">
      {{ conference | default: "MLS" }} Conference &nbsp;•&nbsp; #{{ standing | default: "-" }} &nbsp;•&nbsp; {{ points | default: "0" }} pts
    </span>
    <!-- Extra info on large TRMNL X display -->
    <div class="hidden lg:flex gap--medium label label--base label--gray mt--1">
      <span>Season Record: <strong>{{ record | default: "-" }}</strong></span>
      <span>•</span>
      <span>Standing: <strong>#{{ standing | default: "-" }}</strong> in {{ conference | default: "MLS" }} ({{ points | default: "0" }} Points)</span>
    </div>
  </div>

  <!-- Record bar -->
  <div class="flex gap--large lg:gap--xxlarge portrait:gap--medium">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium lg:value--xlarge pr--3">{{ wins | default: "0" }}</span>
        <span class="label lg:label--base">W</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium lg:value--xlarge pr--3">{{ draws | default: "0" }}</span>
        <span class="label lg:label--base">D</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium lg:value--xlarge pr--3">{{ losses | default: "0" }}</span>
        <span class="label lg:label--base">L</span>
      </div>
    </div>
    <div class="hidden lg:flex item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium lg:value--xlarge pr--3">{{ points | default: "0" }}</span>
        <span class="label lg:label--base">PTS</span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Last Result -->
  {% if last_result %}
  <div class="flex flex--col gap--small lg:gap--medium">
    <span class="label label--underline lg:label--base">LAST RESULT</span>
    <div class="flex flex--between flex--center-y portrait:flex--wrap">
      <div class="flex flex--center-y gap--small lg:gap--medium">
        <span class="label label--filled lg:label--large {% if last_result.outcome == 'W' %}label--success{% elsif last_result.outcome == 'L' %}label--error{% else %}label--warning{% endif %}">
          {{ last_result.outcome | default: "FT" }}
        </span>
        <span class="value lg:value--large">
          {% if last_result.is_home %}vs {% else %}@ {% endif %}{{ last_result.opponent | default: "Opponent" }}
        </span>
        <span class="hidden lg:inline label label--gray">
          ({% if last_result.is_home %}Home Match{% else %}Away Match{% endif %})
        </span>
      </div>
      <div class="flex flex--center-y gap--small lg:gap--medium">
        <span class="value value--medium lg:value--large">{{ last_result.score | default: "FT" }}</span>
        <span class="label label--gray lg:label--base">{{ last_result.date | default: "" }}</span>
      </div>
    </div>
  </div>
  <div class="divider"></div>
  {% endif %}

  <!-- Upcoming Fixtures (Next 3 Games) -->
  <div class="flex flex--col gap--small lg:gap--medium portrait:gap--tiny">
    <span class="label label--underline lg:label--base">UPCOMING MATCHES</span>

    {% if no_upcoming or next_game == nil %}
    <span class="label label--gray lg:label--base">Season complete — no upcoming fixtures.</span>
    {% else %}

    {% if next_game %}
    <div class="flex flex--between flex--center-y">
      <div class="flex flex--center-y gap--small">
        <span class="value lg:value--large">
          • {% if next_game.is_home %}vs {% else %}@ {% endif %}{{ next_game.opponent | default: "Opponent" }}
        </span>
        <span class="hidden lg:inline label label--gray">
          ({% if next_game.is_home %}Home{% else %}Away{% endif %})
        </span>
      </div>
      <span class="label label--gray lg:label--base">{{ next_game.date | default: "TBD" }} &nbsp; {{ next_game.time | default: "" }}</span>
    </div>
    {% endif %}

    {% if next_game_2 %}
    <div class="flex flex--between flex--center-y">
      <div class="flex flex--center-y gap--small">
        <span class="value lg:value--large">
          • {% if next_game_2.is_home %}vs {% else %}@ {% endif %}{{ next_game_2.opponent | default: "Opponent" }}
        </span>
        <span class="hidden lg:inline label label--gray">
          ({% if next_game_2.is_home %}Home{% else %}Away{% endif %})
        </span>
      </div>
      <span class="label label--gray lg:label--base">{{ next_game_2.date | default: "TBD" }} &nbsp; {{ next_game_2.time | default: "" }}</span>
    </div>
    {% endif %}

    {% if next_game_3 %}
    <div class="flex flex--between flex--center-y">
      <div class="flex flex--center-y gap--small">
        <span class="value lg:value--large">
          • {% if next_game_3.is_home %}vs {% else %}@ {% endif %}{{ next_game_3.opponent | default: "Opponent" }}
        </span>
        <span class="hidden lg:inline label label--gray">
          ({% if next_game_3.is_home %}Home{% else %}Away{% endif %})
        </span>
      </div>
      <span class="label label--gray lg:label--base">{{ next_game_3.date | default: "TBD" }} &nbsp; {{ next_game_3.time | default: "" }}</span>
    </div>
    {% endif %}

    {% endif %}
  </div>

  <!-- Footer: last updated -->
  <div class="label label--small lg:label--base label--gray">Updated {{ updated_at | default: "Recently" }}</div>

</div>

<div class="title_bar">
  <span class="title">{{ team_name | default: "MLS Tracker" }}</span>
  <span class="instance">MLS</span>
</div>
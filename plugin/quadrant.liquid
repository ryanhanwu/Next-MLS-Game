<div class="layout layout--col gap--space-between">
  <div class="flex flex--col gap--tiny">
    <span class="title title--small">{{ team_name | default: "MLS Team" }}</span>
    <span class="label label--small">#{{ standing | default: "-" }} • {{ points | default: "0" }} pts • {{ wins | default: "0" }}W-{{ draws | default: "0" }}D-{{ losses | default: "0" }}L</span>
  </div>

  <div class="divider"></div>

  {% if next_game %}
  <div class="flex flex--col gap--tiny">
    <span class="label label--underline">NEXT MATCH</span>
    <span class="value">
      {% if next_game.is_home %}vs{% else %}@{% endif %} {{ next_game.opponent_abbr | default: next_game.opponent }} • {{ next_game.date | default: "TBD" }}
    </span>
  </div>
  {% else %}
  <span class="label label--gray">No upcoming matches</span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ team_name | default: "MLS Tracker" }}</span>
  <span class="instance">MLS</span>
</div>
